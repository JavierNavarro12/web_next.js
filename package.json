{
  "name": "web_next.js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "prepare": "husky install",
    "test": "jest",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "cypress run",
    "test:all": "npm run test && npm run test:e2e",
    "docs:open": "open docs/",
    "clean": "find . -name '.DS_Store' -delete && rm -rf .next coverage",
    "start:prod": "PORT=3000 next start",
    "e2e:prod": "npm run build && PORT=3000 next start & npx wait-on http://localhost:3000 && npx cypress run --headless --browser chrome"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "@sentry/browser": "^8.31.0",
    "@sentry/node": "^8.31.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^12.6.0",
    "hls.js": "^1.5.17",
    "next": "15.4.8",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "resend": "^4.7.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@squoosh/cli": "^0.7.1",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^14.5.3",
    "eslint": "^9",
    "eslint-config-next": "15.4.8",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3",
    "sharp-cli": "^5.2.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "^5"
  }
}
