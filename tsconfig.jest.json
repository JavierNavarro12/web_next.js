{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "@testing-library/jest-dom", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": false,
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": [
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/setupTests.ts",
    "src/types/jest.d.ts"
  ],
  "exclude": [
    "cypress/**/*",
    "cypress.config.ts",
    "tsconfig.cypress.json",
    "node_modules",
    "**/*.cy.ts"
  ]
}
